# ==============================================================================
# Finura Server Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Application Settings
PORT=4000
NODE_ENV=development

# Database Connection (REQUIRED)
# MongoDB connection URI (e.g. mongodb://localhost:27017/finura or Atlas cluster URI)
MONGO_URI=mongodb://127.0.0.1:27017/finura

# Security & Authentication (REQUIRED)
# Secure, high-entropy JWT secret key (DO NOT use default or guessable strings in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# CORS & Client Integration
# URL of the frontend client for strict CORS headers
CLIENT_URL=http://localhost:5173

# Email Service Configuration (Optional for Password Reset)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@finura.com

# Google OAuth Integration (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
