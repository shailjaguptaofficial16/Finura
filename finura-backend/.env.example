# ===============================================================================
# Finura Backend - Development Environment Example
# Copy to .env for local development.
# Keep production values in a separate .env or host secret manager.
# ===============================================================================

NODE_ENV=development
PORT=4000

# MongoDB connection string for local development.
# Example: mongodb://127.0.0.1:27017/finura
MONGO_URI=mongodb://127.0.0.1:27017/finura

# JWT settings
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=7d

# Trusted frontend origin for CORS and security headers.
CLIENT_URL=http://localhost:5173

# Optional email service
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=no-reply@finura.local

# Optional Google OAuth
GOOGLE_CLIENT_ID=

# Optional app metadata
APP_NAME=Finura
APP_URL=http://localhost:5173
